{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project=unit --run",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest --project=unit --run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --project=storybook --run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.4",
    "dayjs": "^1.11.23",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "storybook": "^10.6.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
